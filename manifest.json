{
  "schemaVersion": 1,
  "id": "alijiujiu.sysmon",
  "name": "Sysmon",
  "version": "1.0.0",
  "author": "alijiujiu",
  "license": "MIT",
  "description": "Framed CPU, memory, and network-rate readout for the Omarchy bar, with one-click btop for detail.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "Sysmon",
    "description": "Live CPU %, memory %, and network down/up rate in a framed pill; click for a maximized btop.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "interval": 2,
      "fontSize": 11,
      "borderAlpha": 0.7
    },
    "schema": [
      {
        "key": "interval",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 2
      },
      {
        "key": "fontSize",
        "type": "integer",
        "label": "Font size",
        "min": 8,
        "max": 18,
        "step": 1,
        "defaultValue": 11
      },
      {
        "key": "borderAlpha",
        "type": "number",
        "label": "Frame opacity",
        "min": 0,
        "max": 1,
        "step": 0.05,
        "defaultValue": 0.7
      },
      {
        "key": "onClick",
        "type": "string",
        "label": "Left click command"
      },
      {
        "key": "onRightClick",
        "type": "string",
        "label": "Right click command"
      }
    ]
  }
}
